  "components": {
    "schemas": {
      "CreateOrderRequest": {
        "required": [
          "items"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItemRequest"
            }
          }
        }
      },
      "KitchenBatchLineResponse": {
        "required": [
          "orderCode",
          "pizzaName",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "orderCode": {
            "type": "string"
          },
          "pizzaName": {
            "type": "string"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "KitchenBatchResponse": {
        "required": [
          "batchId",
          "estimatedStartAt",
          "estimatedBakeStartAt",
          "estimatedReadyAt",
          "lines"
        ],
        "type": "object",
        "properties": {
          "batchId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "estimatedStartAt": {
            "type": "string",
            "format": "date-time"
          },
          "estimatedBakeStartAt": {
            "type": "string",
            "format": "date-time"
          },
          "estimatedReadyAt": {
            "type": "string",
            "format": "date-time"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KitchenBatchLineResponse"
            }
          }
        }
      },
      "KitchenViewResponse": {
        "required": [
          "batches"
        ],
        "type": "object",
        "properties": {
          "batches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KitchenBatchResponse"
            }
          }
        }
      },
      "MenuItemResponse": {
        "required": [
          "id",
          "name",
          "description",
          "price"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "price": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "OrderItemRequest": {
        "required": [
          "pizzaId",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "pizzaId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "OrderResponse": {
        "required": [
          "code",
          "status",
          "estimatedReadyAt",
          "readyAt"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          },
          "estimatedReadyAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "readyAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "OrderStatus": {
        "type": "integer"
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
